# Core app
APP_NAME=Nostressia API
API_PREFIX=/api

# Database (required unless DATABASE_URL is set)
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=3306
DB_NAME=
DATABASE_URL=

# JWT
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Email (Brevo)
BREVO_API_KEY=

# Azure Storage (optional)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=profile-avatars
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_CONTAINER_NAME=

# Web Push (optional)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:nostressia.official@gmail.com

# Internal training token (optional)
INTERNAL_TOKEN=
