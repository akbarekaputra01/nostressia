# ==============================
# Core App
# ==============================
APP_TIMEZONE=Asia/Jakarta
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://nostressia.vercel.app
ENABLE_METRICS=true

# ==============================
# Database
# Use DATABASE_URL OR DB_* variables.
# ==============================
DATABASE_URL=mysql+mysqlconnector://root:@localhost:3306/nostressia
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
DB_NAME=nostressia

# ==============================
# Auth
# ==============================
JWT_SECRET=replace_with_secure_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ==============================
# Email (Brevo)
# ==============================
BREVO_API_KEY=

# ==============================
# Azure Storage
# ==============================
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_CONTAINER_NAME=
AZURE_STORAGE_CONTAINER=profile-avatars

# ==============================
# Push Notification (Web Push)
# ==============================
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:nostressia.official@gmail.com

# ==============================
# Internal ML Data Source (optional)
# ==============================
DATA_SOURCE=db
BACKEND_BASE_URL=http://localhost:8000
INTERNAL_TOKEN=

# ==============================
# Optional external tokens (for CI/integrations)
# ==============================
GITHUB_TOKEN=
HF_TOKEN=
HUGGINGFACEHUB_API_TOKEN=

# ==============================
# Optional frontend vars if managed in one environment file
# (typically these belong in nostressia-frontend/.env)
# ==============================
VITE_API_BASE_URL=http://localhost:8000
VITE_VAPID_PUBLIC_KEY=
VITE_LOG_LEVEL=info
