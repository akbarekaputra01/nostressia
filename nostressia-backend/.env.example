# Application
APP_NAME="Nostressia API"
API_PREFIX="/api"
LOG_LEVEL="INFO"

# Database (required unless DATABASE_URL is set)
DB_USER="your_db_user"
DB_PASSWORD="your_db_password"
DB_HOST="localhost"
DB_PORT="3306"
DB_NAME="nostressia"
DATABASE_URL=""

# Auth / JWT
JWT_SECRET="replace-with-strong-secret"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="1440"

# Email (Brevo)
BREVO_API_KEY=""

# Azure Storage (optional)
AZURE_STORAGE_CONNECTION_STRING=""
AZURE_STORAGE_CONTAINER="profile-avatars"
AZURE_STORAGE_ACCOUNT_NAME=""
AZURE_STORAGE_CONTAINER_NAME=""

# Push notifications (optional)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:nostressia.official@gmail.com"

# Internal training data token (optional)
INTERNAL_TOKEN=""
