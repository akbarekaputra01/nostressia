DB_NAME=nostressia

# ==============================
# Data source options for notebooks/scripts
# db | csv | api
# ==============================
DATA_SOURCE=db
BACKEND_BASE_URL=http://localhost:8000
INTERNAL_TOKEN=
SECONDARY_OUTPUT_PATH=

# Git metadata (optional, for experiment metadata)
GITHUB_SHA=
GIT_SHA=

# Optional external tokens (for CI/integrations)
